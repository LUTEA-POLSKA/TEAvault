{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TEAvault",
  "version": "0.1.0",
  "identifier": "app.teavault.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TEAvault",
        "width": 1120,
        "height": 760,
        "minWidth": 1120,
        "maxWidth": 1120,
        "minHeight": 760,
        "maxHeight": 760,
        "resizable": false,
        "center": true,
        "visible": true,
        "decorations": false,
        "shadow": false,
        "titleBarStyle": "overlay",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}